{
  "name": "whisperflow-local",
  "version": "1.0.0",
  "description": "Private, offline desktop dictation powered by Whisper",
  "author": "Whisperflow Local contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "setup:model": "node scripts/download-model.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:engine": "node scripts/check-engine.mjs",
    "test:desktop": "node scripts/check-desktop.mjs",
    "dist": "node scripts/verify-model.mjs && electron-builder --win portable",
    "pack": "node scripts/verify-model.mjs && electron-builder --dir"
  },
  "dependencies": { "@huggingface/transformers": "4.3.1" },
  "devDependencies": { "electron": "44.9.0", "electron-builder": "26.15.3", "playwright-core": "1.64.1" },
  "build": {
    "appId": "local.whisperflow.desktop",
    "productName": "Whisperflow Local",
    "toolsets": { "nsis": "1.2.1" },
    "directories": { "output": "release" },
    "files": ["electron/**/*", "src/**/*", "shared/**/*", "package.json", "LICENSE", "THIRD_PARTY.md"],
    "asarUnpack": ["node_modules/onnxruntime-node/**/*", "node_modules/sharp/**/*", "node_modules/@img/**/*"],
    "extraResources": [{ "from": "models", "to": "models" }],
    "win": { "target": "portable" }
  }
}
